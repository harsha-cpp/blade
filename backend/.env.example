# ===========================================================================
# Blade DLP - backend configuration reference
#
# Every field on Settings (backend/blade_backend/settings.py) appears below
# with its real default. Copy this file and edit:
#
#   local dev   :  cp backend/.env.example backend/.env
#   docker prod :  cp backend/.env.example infra/api.env
#                  (infra/docker-compose.prod.yml OVERRIDES the connection
#                   strings and every secret from infra/.env - see the
#                   "MANAGED BY COMPOSE" markers below)
#
# The values here are the LOCAL DEVELOPMENT defaults. Lines marked
#   *** PRODUCTION: ... ***
# must be changed before you deploy, and five of them are enforced:
# Settings.enforce_deployed_security() refuses to construct - so the app will
# not boot at all - when APP_ENV is anything other than "local" or "test" and
# any of these is true:
#
#   1. REFRESH_COOKIE_SECURE is false
#   2. JWT_SECRET starts with "change-me"
#   3. STORAGE_BACKEND is "local"
#   4. MAILER_BACKEND is "console"
#   5. AUDIT_HMAC_KEY is unset
#
# LIST-VALUED SETTINGS TAKE EITHER FORM. The settings sources in settings.py
# accept a comma-separated list or a JSON array for CORS_ORIGINS,
# API_RATE_LIMIT_EXEMPT_PATHS, LANDING_ORIGINS and PLATFORM_ADMIN_EMAILS, so
# `CORS_ORIGINS=https://a,https://b` and `CORS_ORIGINS=["https://a","https://b"]`
# are the same setting. An empty value means the empty list.
# ===========================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# "local" or "test" relax the four hard checks above. EVERY other value -
# production, staging, uat, or a typo - turns them on, so a misspelt env fails
# closed, and the same rule hides the interactive /docs page.
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# "json" for shippable logs, anything else for human-readable console output.
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Only used if you start uvicorn from Settings; the container CMD passes its own.
API_HOST=0.0.0.0
API_PORT=8000
# CSV or JSON array of dashboard origins allowed to call the API with credentials.
# *** PRODUCTION: set to your dashboard's https origin. *** MANAGED BY COMPOSE ***
CORS_ORIGINS=["http://localhost:5173"]
# CSV or JSON array of MARKETING SITE origins. The landing page is served from a
# different origin than the dashboard and only ever calls two anonymous
# endpoints, so it gets its own narrow allow-list instead of being added to
# CORS_ORIGINS (which is credentialed and covers the whole API). These origins
# are permitted on POST /api/v1/public/access-requests and
# GET /api/v1/public/signup-status ONLY, without credentials. Leave empty if
# you do not run the marketing site.
# *** PRODUCTION: set to your marketing site's https origin. ***
LANDING_ORIGINS=[]

# ---------------------------------------------------------------------------
# Database                                              *** MANAGED BY COMPOSE ***
# ---------------------------------------------------------------------------
# Two URLs for one database: the app runs on asyncpg, alembic runs on psycopg.
# They must point at the same place or migrations land in the wrong database.
DATABASE_URL=postgresql+asyncpg://blade:blade@localhost:5433/blade
DATABASE_SYNC_URL=postgresql+psycopg://blade:blade@localhost:5433/blade
# Managed Postgres (Neon, Supabase, RDS) needs TLS, and the two drivers spell it
# differently. asyncpg is not libpq: it rejects sslmode and channel_binding, and
# takes ssl=require instead. Copying one provider URL into both lines will fail.
#   DATABASE_URL=postgresql+asyncpg://USER:PW@HOST/DB?ssl=require
#   DATABASE_SYNC_URL=postgresql+psycopg://USER:PW@HOST/DB?sslmode=require&channel_binding=require
# Per-process pool. Total connections = (pool + overflow) x api replicas
# x uvicorn workers, plus the Celery workers. Postgres' default max_connections
# is 100; size these so the sum stays under it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Required true behind a transaction-mode pooler (PgBouncer, Neon, Supabase),
# where a prepared statement from one transaction is invisible to the next.
# Harmless but slightly slower against a direct Postgres connection.
DATABASE_DISABLE_PREPARED_STATEMENTS=true
# A pooled connection can be handed over with a session GUC left set by whoever
# used it last. A data load that ends with search_path='' will therefore break
# unqualified queries for the next client. Pin the default on the role once:
#   ALTER ROLE <user> IN DATABASE <db> SET search_path TO public;

# Readiness probe budget per component. The 5s default suits an API co-located
# with the database; raise it when running against a database in another region,
# where one probe costs several round trips.
READINESS_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Redis / Celery                                        *** MANAGED BY COMPOSE ***
# ---------------------------------------------------------------------------
# Used by the readiness probe and the API rate limiter.
REDIS_URL=redis://localhost:6379/0
# Queue. Keep the result backend on a different database number so a
# `FLUSHDB` on results cannot drop queued scans.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Queued attachment scans are OCR-heavy. The SOFT limit raises an exception the
# task catches, so it can mark the attachment scan failed (which the policy
# engine treats as an unread attachment, never a silent allow); the HARD limit
# kills the worker process a little later if that did not work. The hard limit
# must be greater than the soft limit or the app refuses to start. Tasks are
# acknowledged late, so a task lost to a worker crash is redelivered after the
# broker's visibility timeout, which is set to the hard limit plus 60s.
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=330
# Celery beat runs blade.maintenance.purge_expired_tokens daily at 03:17 UTC.
# It deletes refresh, password reset, email verification and device token rows
# that have been expired, revoked or rotated for longer than this, in batches of
# 1000. Keep it comfortably longer than JWT_REFRESH_TTL_DAYS so a live session is
# never swept, and long enough that a replayed stolen token still lands on a
# rotated row and trips reuse detection.
TOKEN_RETENTION_DAYS=30
# Marketing-site access requests older than this are deleted by the same task.
# 0 keeps them forever, which is the default: they are sales leads, not
# credentials, and no patient data goes near them.
ACCESS_REQUEST_RETENTION_DAYS=0
# *** PRODUCTION: use redis://:PASSWORD@host:6379/0 - an unauthenticated Redis
# reachable from anywhere is a full read of every queued attachment. ***

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs access and refresh tokens. Rotating it logs every user out immediately.
# *** PRODUCTION (ENFORCED): must not start with "change-me". ***
#   openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=change-me-change-me-change-me-32!
JWT_ALGORITHM=HS256
# Short access token; the dashboard refreshes silently. 900s = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=blade_refresh
# *** PRODUCTION (ENFORCED): must be true. The refresh cookie is a 30-day
# credential; without Secure it goes out over plain HTTP. ***
REFRESH_COOKIE_SECURE=false
# lax | strict | none. "none" is required when the dashboard and the API are on
# different hostnames (and browsers only accept it together with Secure).
REFRESH_COOKIE_SAMESITE=lax
# Per-IP login throttle. Low on purpose: these are password attempts.
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_HOUR=20
# How many proxies append to X-Forwarded-For between the browser and the API.
# 0 = the API is directly exposed. 1 = one nginx/Caddy/ALB in front.
# *** PRODUCTION: get this right. Too low and every hospital shares one rate-limit
# bucket (one attacker locks out a whole tenant); too high and a client can forge
# its own source IP and bypass the throttle entirely. ***
TRUSTED_PROXY_COUNT=0
# Self-serve tenant creation.
# *** PRODUCTION: false for hospital installs - operators create the org and
# staff join by invite. ***
ALLOW_OPEN_SIGNUP=true
# Two dashboard tabs can refresh at the same moment. A rotated refresh token
# stays valid this long before a reuse is treated as token theft.
REFRESH_ROTATION_GRACE_SECONDS=60
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_HOURS=24
# How long an enrolled extension install stays trusted before re-enrolling.
DEVICE_TOKEN_TTL_DAYS=365
# Shown in the user's authenticator app next to the TOTP code.
MFA_ISSUER=Blade DLP
# Encrypts TOTP seeds at rest, so a database dump does not hand over MFA.
#
# Left COMMENTED OUT deliberately. settings.py falls back to JWT_SECRET when this
# is UNSET, but an env var set to the empty string is not unset: it becomes
# SecretStr('') and the fallback never runs, so TOTP seeds get encrypted with an
# empty key. Either give it a real value or leave the line commented.
# *** PRODUCTION: set a second, independent secret - sharing JWT_SECRET means
# rotating the JWT secret locks every user out of MFA. ***
#   openssl rand -base64 48 | tr -d '\n'
#MFA_ENCRYPTION_KEY=
# Keys the HMAC stored on every audit_events row, so a chain rebuilt by someone
# with write access to the table still fails verification: recomputing the hash
# chain is free, recomputing the signatures needs this key.
#
# REQUIRED in deployed environments (see check 5 at the top of this file). When
# it is unset the app falls back to a fixed development key and logs a warning
# at startup. Rotating it makes every existing row report as an HMAC failure,
# so treat it as permanent for the life of the log.
# *** PRODUCTION: set a third, independent secret. ***
#   openssl rand -base64 48 | tr -d '\n'
#AUDIT_HMAC_KEY=

# ---------------------------------------------------------------------------
# API rate limiting (RateLimitMiddleware)
# ---------------------------------------------------------------------------
# Per key (IP, or authenticated principal) per minute, shared across processes
# through Redis. High because a hospital behind one NAT address puts every
# workstation on a single key.
API_RATE_LIMIT_PER_MINUTE=600
# JSON array. Paths excluded from the global limit because they have their own
# per-device limits. Leave unset to keep the built-in default.
API_RATE_LIMIT_EXEMPT_PATHS=["/api/v1/scan","/api/v1/events"]
# Ceiling on the in-memory fallback used when Redis is unreachable, so a spray
# of unique keys cannot exhaust a worker's memory.
API_RATE_LIMIT_MAX_KEYS=10000
# Largest JSON request body the API will accept, refused from Content-Length
# before the body is read and enforced again while streaming a chunked body.
# This is the only thing standing between an unauthenticated POST and the API's
# memory: FastAPI parses the body before any dependency, including auth, runs.
# Must stay above the largest legitimate message body (SCAN_EMAIL body is capped
# at 1,000,000 characters, which is up to 4 MiB of UTF-8 in the worst case, but
# clinical text is close to 1 byte per character). The attachment upload route
# has its own larger limit, see SCAN_MAX_ATTACHMENT_BYTES.
API_MAX_REQUEST_BYTES=2097152

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------
# console | smtp. "console" writes the mail to the log and delivers nothing.
# *** PRODUCTION (ENFORCED): must be smtp - invites, password resets and email
# verification are all undeliverable otherwise. ***
MAILER_BACKEND=console
SMTP_HOST=localhost
# 587 for STARTTLS (with SMTP_TLS=true), 465 for implicit TLS, 1025 for MailHog.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Blade DLP <no-reply@localhost>
SMTP_TLS=true
# Where to mail a copy of each new access request from the marketing site form.
# Empty disables the notification; the access_requests table is the record of
# truth either way and a mail failure never fails the visitor's submission.
ACCESS_REQUEST_NOTIFY_EMAIL=
# CSV or JSON array of addresses allowed to read and triage access requests
# through GET/PATCH /api/v1/access-requests. There is no platform-admin role in
# the database: the caller must be signed in, hold the "owner" role in their own
# org, AND have their address listed here. Empty means nobody can reach those
# two endpoints.
PLATFORM_ADMIN_EMAILS=[]
# Public URL of the DASHBOARD. Invite / reset / verification links are built from
# it, so a wrong value produces mail nobody can act on.
# *** PRODUCTION: set to the dashboard's https URL. ***
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Attachments and object storage
# ---------------------------------------------------------------------------
# Scratch directories. Created at startup and chmod 0700, so the runtime user
# must own them. The container images set these to /var/lib/blade/*.
ATTACHMENT_TEMP_DIR=/tmp/blade-attachments
QUARANTINE_STORAGE_DIR=/tmp/blade-quarantine
# Attachments larger than this skip the inline scan and go to the Celery queue.
SCAN_DEEP_SCAN_THRESHOLD_BYTES=10485760
# local | s3.
# *** PRODUCTION (ENFORCED): must be s3. "local" requires the API and the Celery
# worker to share a filesystem, so a queued attachment written by the API is
# simply missing when a worker on another host tries to read it. ***
STORAGE_BACKEND=local
# --- s3 backend (also MinIO / any S3-compatible store) --- MANAGED BY COMPOSE ---
S3_BUCKET=blade-attachments
# Key prefix inside the bucket.
S3_PREFIX=queued-scans
S3_REGION=ap-south-1
# Set for MinIO (http://minio:9000). Leave EMPTY for real AWS S3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AES256 or aws:kms on real S3. MUST BE EMPTY for MinIO, which rejects the
# server-side-encryption header with 400 unless KMS is configured.
S3_SERVER_SIDE_ENCRYPTION=AES256

# ---------------------------------------------------------------------------
# Scan execution
# ---------------------------------------------------------------------------
# Detection is CPU-bound and synchronous, so it runs in worker PROCESSES, not
# threads: a thread stuck in a C extension cannot be cancelled, so it would hold
# its slot and its memory forever. This is the number of worker processes and
# the number of scans that can run at once. Each worker keeps its own copy of
# the spaCy model (about 300 MB resident), so budget memory as
# SCAN_MAX_CONCURRENCY x 300 MB on top of the API process. Set at or below the
# container's CPU limit; higher just adds queueing latency. Range 1-64.
SCAN_MAX_CONCURRENCY=4
# Wall-clock budget for one detection job. When it is exceeded the worker is
# killed, its memory is reclaimed, and the scan is reported as degraded (a warn
# floor, never a silent allow). Keep it BELOW the extension's own per-request
# timeouts (10s finalize, 15s attachment upload) so the user gets a verdict
# rather than a network error. Detection is roughly 50 KB of message text per
# second per worker, so with the default a body over about 250 KB is reported
# as unread rather than scanned.
SCAN_DEADLINE_SECONDS=8
# A worker process is retired and replaced after this many scans, so a leaked
# allocation in a parser cannot accumulate. Lower recycles more aggressively at
# the cost of one model reload (about 1.5s) on the next scan that lands there.
SCAN_WORKER_MAX_TASKS=100
# Hard ceiling on a single uploaded attachment. The middleware refuses a larger
# request from its Content-Length before the body is read, and the upload is
# read in bounded chunks so a lying Content-Length cannot beat it. Keep at or
# above the extension's own 25 MiB client-side cap.
SCAN_MAX_ATTACHMENT_BYTES=26214400
# Detection runs in a separate process pool by default. Set false ONLY for
# tests or a single-process debug session: detection then runs in a thread and
# a stuck job cannot be killed.
SCAN_PROCESS_POOL_ENABLED=true
# /api/v1/scan and /api/v1/events are exempt from the IP-keyed global limiter,
# because a whole hospital shares one NAT address. Their budget is keyed on the
# credential instead. Per enrolled extension install:
SCAN_RATE_LIMIT_PER_DEVICE_PER_MINUTE=60
# ...and per organisation, as a ceiling across all of its devices.
SCAN_RATE_LIMIT_PER_ORG_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Empty disables Sentry. Note the DSN is not itself a secret, but the events it
# carries can contain patient data - check your scrubbing before enabling.
SENTRY_DSN=
